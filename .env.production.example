# Copy to .env on the VPS and fill in real values:
#   cp .env.production.example .env

# App
APP_NAME="RideDelivery API"
APP_ENV=production
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Postgres (used by docker-compose.prod.yml)
POSTGRES_DB=ridedelivery
POSTGRES_USER=ridedelivery
POSTGRES_PASSWORD=change-me-strong-db-password

# These are overridden by compose to point at the `db` / `redis` services,
# but keep placeholders so Settings() can load if needed.
DATABASE_URL=postgresql+asyncpg://ridedelivery:change-me-strong-db-password@db:5432/ridedelivery
DATABASE_URL_SYNC=postgresql://ridedelivery:change-me-strong-db-password@db:5432/ridedelivery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# M-Pesa Daraja — set callback to your public HTTPS domain
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://api.yourdomain.com/api/v1/payments/mpesa/callback
MPESA_ENV=sandbox

# Rider assignment
RIDER_RESPONSE_TIMEOUT_SECONDS=300
MAX_SEARCH_RADIUS_KM=10
INITIAL_SEARCH_RADIUS_KM=3
MAX_ASSIGNMENT_ATTEMPTS=5

# Optional
UVICORN_WORKERS=2
FCM_SERVER_KEY=
